    "pages": [
      {
        "title": "Grote en kleine wijzer",
        "skill": "wijzers",
        "text": "De kleine wijzer wijst het uur aan. De grote wijzer wijst de minuten aan. Staat de grote wijzer op de 12? Dan is het een heel uur. Op de 6 is het half, op de 3 kwart over, op de 9 kwart voor.",
        "examples": [
          {
            "good": "Grote wijzer op de 6, kleine wijzer tussen de 2 en de 3: half 3.",
            "bad": "Half 2.",
            "why": "Half 3 betekent halfweg naar 3 uur."
          }
        ],
        "tip": "Elk cijfer op de klok is 5 minuten voor de grote wijzer."
      },
      {
        "title": "Over en voor het hele uur",
        "skill": "over-en-voor",
        "text": "Tot kwart over zeg je minuten over het uur. Na kwart voor zeg je minuten voor het volgende uur. Bij voor tel je de minuten die nog missen tot 60.",
        "examples": [
          {
            "good": "8:05 is 5 minuten over 8."
          },
          {
            "good": "7:54 is 6 minuten voor 8.",
            "bad": "7:54 is 6 minuten voor 7.",
            "why": "Bij voor noem je het uur dat eraan komt."
          }
        ],
        "tip": "Voor = hoeveel minuten nog tot het volgende hele uur."
      },
      {
        "title": "Rond half",
        "skill": "rond-half",
        "text": "Tussen kwart over en kwart voor kijk je naar half. Half 8 is 7:30. Iets eerder is voor half 8, iets later is over half 8.",
        "examples": [
          {
            "good": "7:20 is 10 minuten voor half 8."
          },
          {
            "good": "7:40 is 10 minuten over half 8.",
            "bad": "7:40 is 10 minuten over half 7.",
            "why": "Half 8 is 7:30. Daar komen 10 minuten bij."
          }
        ],
        "tip": "Half 8 is halfweg naar 8 uur, dus 7:30."
      }
    ]
  },
