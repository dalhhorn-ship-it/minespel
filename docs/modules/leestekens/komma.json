      {
        "title": "Komma tussen twee werkwoorden",
        "text": "Begint de zin met als, toen of omdat? Dan staan er vaak twee werkwoorden naast elkaar. Daartussen komt een komma.",
        "examples": [
          {
            "good": "Als het regent, blijven wij binnen.",
            "why": "Regent en blijven staan naast elkaar. Daartussen komt de komma."
          }
        ],
        "tip": "Twee werkwoorden naast elkaar? Komma ertussen.",
        "skill": "twee-werkwoorden"
      }
    ]
