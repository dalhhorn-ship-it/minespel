// Cloudflare Workers hosting for Dino Blokwereld.
// Static assets only: there is no Worker script, no KV, D1 or R2 (PRD section 10).
// Not to be confused with the browser service worker in offline/service-worker.js.
// Never put an account id or a token in this file. Deploying is a founder action at /ship.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "minespel",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./dist"
  },
  // Request logs in the founder's own Cloudflare dashboard (Workers Logs). No app data is sent.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  // Cloudflare Workers Builds runs `npx wrangler preview` for non-main branches (PR previews),
  // which needs this block, even empty. main deploys with `wrangler deploy`.
  "previews": {},
  "workers_dev": true,
  "preview_urls": false
}
