        "title": "Optellen met dezelfde noemer",
        "skill": "gelijknamig-optellen",
        "text": "Hebben de breuken dezelfde noemer? Tel dan alleen de tellers op. De noemer blijft hetzelfde.",
        "examples": [
          {
            "good": "1/5 + 2/5 = 3/5",
            "bad": "1/5 + 2/5 = 3/10",
            "why": "De stukken blijven vijfden. Tel de noemers niet op."
          }
        ],
        "tip": "Stukken tel je op, de soort stuk blijft."
      },
      {
        "title": "Aftrekken met dezelfde noemer",
        "skill": "gelijknamig-aftrekken",
        "text": "Bij aftrekken haal je alleen de tellers van elkaar af. De noemer blijft weer hetzelfde.",
        "examples": [
          {
            "good": "5/8 - 2/8 = 3/8"
          }
        ],
        "tip": "De noemer doet niet mee met rekenen."
      },
      {
        "title": "Aanvullen tot één hele",
        "skill": "aanvullen-tot-1",
        "text": "Eén hele kun je schrijven als een breuk met teller en noemer gelijk. Zo kun je een breuk van 1 aftrekken.",
        "examples": [
          {
            "good": "1 - 3/4 = 4/4 - 3/4 = 1/4"
          }
        ],
        "tip": "Maak van 1 eerst 4/4, 5/5 of 8/8."
      }
    ]
  },
