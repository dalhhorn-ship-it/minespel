{
  "permissions": {
    "allow": [
      "Bash(./scripts/check.sh)",
      "Bash(./scripts/signoff.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)"
    ],
    "ask": [
      "Bash(npm run deploy:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(wrangler deploy:*)",
      "Bash(npx wrangler versions:*)",
      "Bash(npx wrangler secret:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prd-gate.sh"
          }
        ]
      }
    ]
  }
}
