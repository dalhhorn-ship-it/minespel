  "lesson": {
    "pages": [
      {
        "title": "Evenveel, andere breuk",
        "skill": "gelijkwaardig",
        "text": "Snijd je elk stuk in tweeën? Dan heb je twee keer zoveel stukken, maar evenveel taart. Doe teller en noemer keer hetzelfde getal.",
        "examples": [
          {
            "good": "1/2 = 2/4 = 4/8"
          },
          {
            "good": "3/4 = 6/8",
            "bad": "3/4 = 3/8",
            "why": "Alleen de noemer veranderen maakt de breuk kleiner."
          }
        ],
        "tip": "Wat je onder doet, doe je ook boven."
      },
      {
        "title": "Zo eenvoudig mogelijk",
        "skill": "vereenvoudigen",
        "text": "Kun je teller en noemer door hetzelfde getal delen? Dan wordt de breuk eenvoudiger, maar niet kleiner. Ga door tot het niet meer kan.",
        "examples": [
          {
            "good": "6/9 = 2/3 (allebei gedeeld door 3)."
          }
        ],
        "tip": "Zoek een getal dat in de teller en de noemer past."
      }
    ]
  },
