// Cloudflare Workers hosting for Dino Blokwereld.
// Static assets only: there is no Worker script, no KV, D1 or R2 (PRD section 10).
// Not to be confused with the browser service worker in offline/service-worker.js.
// Never put an account id or a token in this file. Deploying is a founder action at /ship.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "minespel",
  "compatibility_date": "2026-10-17",
  // Wrangler builds the site first on every deploy or upload, so Cloudflare Workers Builds
  // works even when its dashboard build command is empty.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist"
  },
  "workers_dev": true,
  "preview_urls": false
}
